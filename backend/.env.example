# Copia este archivo a .env y reemplaza los valores.
# Usa el "Session pooler" de Supabase (Project Settings > Database > Connection string),
# funciona en redes IPv4 (Render, casa, universidad).
DATABASE_URL=postgresql+psycopg2://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Opcional: webhook entrante de Slack para avisar cuando se crea un producto
SLACK_WEBHOOK_URL=

# Opcional: orígenes permitidos para CORS separados por coma (por defecto "*")
CORS_ORIGINS=*
